From 9bdbee83753ead4571c910dc596058ed42601bb2 Mon Sep 17 00:00:00 2001
From: StonkGuy <68372320+StonkGuy@users.noreply.github.com>
Date: Wed, 7 Oct 2026 15:09:54 +0300
Subject: [PATCH 9/9] Signals: never block FEX's own signals in the guest
 sigsuspend set

GuestSigSuspend built the host set straight from the guest mask, so a guest
rt_sigsuspend that asked to block SIGSEGV, SIGTRAP or the pause signal made
sigsuspend() mask a signal FEX needs delivered to itself. The host kernel then
kept it pending forever and the guest never saw it. GuestSigProcmask and the
handler-entry path already skip these signals; do the same here.

---
 .../LinuxEmulation/LinuxSyscalls/SignalDelegator.cpp | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator.cpp
index 21d5e16..c81baec 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator.cpp
@@ -1365,16 +1365,18 @@ uint64_t SignalDelegator::GuestSigSuspend(FEX::HLE::ThreadStateObject* Thread, u
   sigemptyset(&HostSet);
 
   for (int32_t i = 0; i < MAX_SIGNALS; ++i) {
+    if (HostHandlers[i + 1].Required.load(std::memory_order_relaxed)) {
+      // FEX's own signals (SIGSEGV, SIGTRAP, the pause signal) cannot be blocked at the host: masking one here would let it
+      // stay pending in the host kernel forever and the guest would never see it. This matches what the handler-entry path
+      // and GuestSignalFD already do.
+      continue;
+    }
+
     if (*set & (1ULL << i)) {
       sigaddset(&HostSet, i + 1);
     }
   }
 
-  // Additionally we must always listen to SIGNAL_FOR_PAUSE
-  // This technically forces us in to a race but should be fine
-  // SIGBUS and SIGILL can't happen so we don't need to listen for them
-  // sigaddset(&HostSet, SIGNAL_FOR_PAUSE);
-
   // Spin this in a loop until we aren't sigsuspended
   // This can happen in the case that the guest has sent signal that we can't block
   uint64_t Result = sigsuspend(&HostSet);
