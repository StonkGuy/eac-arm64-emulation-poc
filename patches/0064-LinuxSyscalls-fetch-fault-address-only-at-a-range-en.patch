From 5412c8130f035cae22eb0b99aeaa633961c178df Mon Sep 17 00:00:00 2001
From: StonkGuy <68372320+StonkGuy@users.noreply.github.com>
Date: Tue, 27 Oct 2026 16:24:33 +0200
Subject: [PATCH] LinuxSyscalls: fetch fault address only at a range end within
 the instruction

An instruction fetch fault reports the end of the executable range that
holds RIP as si_addr, for an instruction that runs from executable memory
into memory that is not. When another thread made RIP's page executable
after the instruction was decoded there, that range ends anywhere on the
page, and the fault reported an address no instruction at RIP can reach.
Take the range end only when it lies within 15 bytes of RIP; otherwise
the instruction's first byte faulted, as on hardware.

THE FINALS decrypts its code pages on their first execute fault, from
several threads, and crashed on such a fault (RIP 0x14c5a4690, address
0x14c5a5000).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../LinuxSyscalls/SignalDelegator/GuestFramesManagement.cpp  | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator/GuestFramesManagement.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator/GuestFramesManagement.cpp
index 54326e8..86e9358 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator/GuestFramesManagement.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator/GuestFramesManagement.cpp
@@ -569,10 +569,13 @@ uint64_t SignalDelegator::SetupFrame_x64(FEXCore::Core::InternalThreadState* Thr
     // (the decoder stopped part way): the CPU reports the first byte it could not fetch, where the executable range
     // ends, with RIP still at the instruction. Wine passes si_addr on as the access violation's address, and
     // anti-tamper code places instructions across a guard page to compare it.
+    // Only a range end within an instruction's 15 bytes can be that byte: a range that ends further on was made
+    // executable by another thread after this instruction was decoded, and its first byte is the one that faulted.
     if (Frame->SynchronousFaultData.TrapNo == FEXCore::X86State::X86_TRAPNO_PF &&
         (Frame->SynchronousFaultData.err_code & FEXCore::X86State::X86_PF_INSTR)) {
+      constexpr uint64_t MaxInstSize = 15;
       const auto Range = FEX::HLE::_SyscallHandler->QueryGuestExecutableRange(Thread, ContextBackup->OriginalRIP);
-      if (Range.Size != 0) {
+      if (Range.Size != 0 && Range.Base + Range.Size - ContextBackup->OriginalRIP < MaxInstSize) {
         guest_siginfo->si_addr = reinterpret_cast<void*>(Range.Base + Range.Size);
       }
     }
