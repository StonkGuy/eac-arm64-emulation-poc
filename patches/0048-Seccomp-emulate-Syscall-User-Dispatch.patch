   if (!HasFilter(Frame)) {
@@ -437,26 +510,7 @@ SeccompEmulator::ExecuteFilter(FEXCore::Core::CpuStateFrame* Frame, uint64_t JIT
     break;
   }
   case SECCOMP_RET_TRAP: {
-    siginfo_t Info {
-      .si_signo = SIGSYS,
-      .si_errno = static_cast<int32_t>(DataMasked),
-      .si_code = 1, // SYS_SECCOMP
-    };
