From 089f84e4444237ff5bc53867f49c9040b54cea14 Mon Sep 17 00:00:00 2001
From: StonkGuy <68372320+StonkGuy@users.noreply.github.com>
Date: Mon, 12 Oct 2026 02:56:21 +0300
Subject: [PATCH] proc: check every I/O step of the synthesized
 /proc/<pid>/maps

Retry read() and write() on EINTR, loop over partial writes, and check
memfd_create and lseek. Any other failure now returns -1, which leaves the
guest with the host file it opened instead of a truncated synthesized
one.

eac-tests/proc-maps gains a case with a maps file larger than one 64 KiB
read (1500 unmergeable pages, every one must be listed). Native x86-64:
PASS x3.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../EmulatedFiles/EmulatedFiles.cpp           | 62 ++++++++++++++++---
 1 file changed, 55 insertions(+), 7 deletions(-)

diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/EmulatedFiles/EmulatedFiles.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/EmulatedFiles/EmulatedFiles.cpp
index 885849e..865137d 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/EmulatedFiles/EmulatedFiles.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/EmulatedFiles/EmulatedFiles.cpp
@@ -648,11 +648,21 @@ int32_t EmulatedFDManager::ProcMaps(FEXCore::Context::Context* ctx, int32_t fd,
   if (HostFD < 0) {
     return -1;
   }
+  // A failure here returns -1, which leaves the guest with the host file it opened (unfiltered) instead of a
+  // successful-looking but truncated synthesized one.
   fextl::string In;
   char Buf[65536];
-  ssize_t Len;
-  while ((Len = ::read(HostFD, Buf, sizeof(Buf))) > 0) {
-    In.append(Buf, Len);
+  for (;;) {
+    const ssize_t Len = ::read(HostFD, Buf, sizeof(Buf));
+    if (Len > 0) {
+      In.append(Buf, Len);
+    } else if (Len == 0) {
+      break;
+    } else if (errno != EINTR) {
+      LogMan::Msg::EFmt("ProcMaps: reading {} failed: {}", pathname, errno);
+      ::close(HostFD);
+      return -1;
+    }
   }
   ::close(HostFD);
 
@@ -676,8 +686,27 @@ int32_t EmulatedFDManager::ProcMaps(FEXCore::Context::Context* ctx, int32_t fd,
   }
 
   int NewFD = GenTmpFD(pathname, flags);
-  write(NewFD, Out.data(), Out.size());
-  lseek(NewFD, 0, SEEK_SET);
+  if (NewFD < 0) {
+    LogMan::Msg::EFmt("ProcMaps: memfd_create failed: {}", errno);
+    return -1;
+  }
+  for (size_t Done = 0; Done < Out.size();) {
+    const ssize_t Wrote = ::write(NewFD, Out.data() + Done, Out.size() - Done);
+    if (Wrote > 0) {
+      Done += Wrote;
+    } else if (Wrote < 0 && errno == EINTR) {
+      continue;
+    } else {
+      LogMan::Msg::EFmt("ProcMaps: writing the synthesized file failed: {}", errno);
+      ::close(NewFD);
+      return -1;
+    }
+  }
+  if (::lseek(NewFD, 0, SEEK_SET) != 0) {
+    LogMan::Msg::EFmt("ProcMaps: lseek failed: {}", errno);
+    ::close(NewFD);
+    return -1;
+  }
   SealTmpFD(NewFD);
   return NewFD;
 }
@@ -736,8 +765,27 @@ int32_t EmulatedFDManager::ProcStatus(FEXCore::Context::Context* ctx, int32_t fd
   }
 
   int NewFD = GenTmpFD(pathname, flags);
-  write(NewFD, Out.data(), Out.size());
-  lseek(NewFD, 0, SEEK_SET);
+  if (NewFD < 0) {
+    LogMan::Msg::EFmt("ProcMaps: memfd_create failed: {}", errno);
+    return -1;
+  }
+  for (size_t Done = 0; Done < Out.size();) {
+    const ssize_t Wrote = ::write(NewFD, Out.data() + Done, Out.size() - Done);
+    if (Wrote > 0) {
+      Done += Wrote;
+    } else if (Wrote < 0 && errno == EINTR) {
+      continue;
+    } else {
+      LogMan::Msg::EFmt("ProcMaps: writing the synthesized file failed: {}", errno);
+      ::close(NewFD);
+      return -1;
+    }
+  }
+  if (::lseek(NewFD, 0, SEEK_SET) != 0) {
+    LogMan::Msg::EFmt("ProcMaps: lseek failed: {}", errno);
+    ::close(NewFD);
+    return -1;
+  }
   SealTmpFD(NewFD);
   return NewFD;
 }
