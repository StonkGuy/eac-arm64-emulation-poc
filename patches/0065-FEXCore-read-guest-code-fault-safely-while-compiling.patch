diff --git a/FEXCore/Source/Utils/FaultSafeRead.cpp b/FEXCore/Source/Utils/FaultSafeRead.cpp
new file mode 100644
index 0000000..33efc6c
--- /dev/null
+++ b/FEXCore/Source/Utils/FaultSafeRead.cpp
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: MIT
+#include <FEXCore/Utils/FaultSafeRead.h>
+
+#include <cstring>
+
+namespace FEXCore::Utils::FaultSafeRead {
+#if defined(ARCHITECTURE_arm64) && !defined(_WIN32)
+// Returns 0 when every byte was copied. When the load faults, the frontend's SIGSEGV handler returns from here with
+// a non-zero x0 (see IsFaultLocation).
+__attribute__((naked)) static size_t CopyImpl(void* Dest, const void* Src, size_t Size) {
+  __asm volatile(R"(
+  // Early exit if a copy of size zero.
+  cbz x2, 2f;
+
+  1:
+  .globl FEXCore_FaultSafeRead_FaultInst
+  FEXCore_FaultSafeRead_FaultInst:
+    ldrb w3, [x1], 1; // <- This line can fault.
+    strb w3, [x0], 1;
+    sub x2, x2, 1;
+    cbnz x2, 1b;
+2:
+    mov x0, 0;
+    ret;
+  )" ::
+                   : "memory");
+}
+
+extern "C" uint64_t FEXCore_FaultSafeRead_FaultInst;
+
+bool Copy(void* Dest, const void* Src, size_t Size) {
+  return CopyImpl(Dest, Src, Size) == 0;
+}
+
+bool IsFaultLocation(uint64_t PC) {
+  return reinterpret_cast<void*>(PC) == &FEXCore_FaultSafeRead_FaultInst;
+}
+#else
+bool Copy(void* Dest, const void* Src, size_t Size) {
+  memcpy(Dest, Src, Size);
+  return true;
+}
+
+bool IsFaultLocation(uint64_t PC) {
+  return false;
+}
+#endif
+} // namespace FEXCore::Utils::FaultSafeRead
diff --git a/FEXCore/include/FEXCore/Utils/FaultSafeRead.h b/FEXCore/include/FEXCore/Utils/FaultSafeRead.h
new file mode 100644
index 0000000..b296af1
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/FaultSafeRead.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <FEXCore/Utils/CompilerDefs.h>
+
+#include <cstddef>
+#include <cstdint>
+
+namespace FEXCore::Utils::FaultSafeRead {
+/**
+ * @brief Copies guest memory that another guest thread can unmap or protect at any time.
+ *
+ * The frontend decodes and hashes guest code while holding code-invalidation locks. A guest mprotect or munmap on
+ * another thread can revoke a page between the frontend's executable-range check and its read. A plain load then
+ * faults inside FEX, and that fault must never reach the guest: a guest handler that resumes elsewhere would leave the
+ * locks held forever.
+ *
+ * The frontend's SIGSEGV handler resumes a fault at IsFaultLocation as a failed copy.
+ *
+ * @return true if all Size bytes were copied, false if the source faulted (Dest is then partly written)
+ */
+FEX_DEFAULT_VISIBILITY bool Copy(void* Dest, const void* Src, size_t Size);
+
+/**
+ * @brief Whether PC is the load in Copy that may fault.
+ */
+FEX_DEFAULT_VISIBILITY bool IsFaultLocation(uint64_t PC);
+} // namespace FEXCore::Utils::FaultSafeRead
