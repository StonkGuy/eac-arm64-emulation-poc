@@ -817,7 +817,10 @@ static std::optional<uint64_t> ReadlinkTraceeExe(const char* Path, char* Buf, si
     return std::nullopt;
   }
   const size_t Len = std::min(BufSize, Exe->size());
-  memcpy(Buf, Exe->data(), Len);
+  if (FaultSafeUserMemAccess::CopyToUser(Buf, Exe->data(), Len)) {
+    errno = EFAULT;
+    return -1;
+  }
   return Len;
 }
 
@@ -828,9 +831,14 @@ uint64_t FileManager::Readlink(const char* pathname, char* buf, size_t bufsiz) {
   snprintf(PidSelfPath, 50, "/proc/%i/exe", CurrentPID);
 
   if (strcmp(pathname, "/proc/self/exe") == 0 || strcmp(pathname, "/proc/thread-self/exe") == 0 || strcmp(pathname, PidSelfPath) == 0) {
+    // Like Linux: copy the link text without a terminator, -EFAULT if the buffer is bad.
     const auto& App = Filename();
-    strncpy(buf, App.c_str(), bufsiz);
-    return std::min(bufsiz, App.size());
+    const size_t Len = std::min(bufsiz, App.size());
+    if (FaultSafeUserMemAccess::CopyToUser(buf, App.c_str(), Len)) {
+      errno = EFAULT;
+      return -1;
+    }
+    return Len;
   }
 
   if (auto Traced = ReadlinkTraceeExe(pathname, buf, bufsiz)) {
@@ -909,9 +917,14 @@ uint64_t FileManager::Readlinkat(int dirfd, const char* pathname, char* buf, siz
   snprintf(PidSelfPath, 50, "/proc/%i/exe", CurrentPID);
 
   if (Path == "/proc/self/exe" || Path == "/proc/thread-self/exe" || Path == PidSelfPath) {
+    // Like Linux: copy the link text without a terminator, -EFAULT if the buffer is bad.
     const auto& App = Filename();
-    strncpy(buf, App.c_str(), bufsiz);
-    return std::min(bufsiz, App.size());
+    const size_t Len = std::min(bufsiz, App.size());
+    if (FaultSafeUserMemAccess::CopyToUser(buf, App.c_str(), Len)) {
+      errno = EFAULT;
+      return -1;
+    }
+    return Len;
   }
 
   if (!Path.empty() && Path[0] == '/') {
diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/Seccomp/SeccompEmulator.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/Seccomp/SeccompEmulator.cpp
index 0322a78..9d40fe2 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/Seccomp/SeccompEmulator.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/Seccomp/SeccompEmulator.cpp
@@ -641,7 +641,10 @@ uint64_t SeccompEmulator::SetModeFilter(FEXCore::Core::CpuStateFrame* Frame, uin
     return -EINVAL;
   }
 
-  if (!prog) {
+  // Like Linux (seccomp_prepare_user_filter), the program header and then its instructions are copied in first; a bad
+  // pointer in either is -EFAULT, not a fault inside the emulator.
+  sock_fprog UserProg;
+  if (FaultSafeUserMemAccess::CopyFromUser(&UserProg, prog, sizeof(UserProg))) {
     return -EFAULT;
   }
 
@@ -650,12 +653,22 @@ uint64_t SeccompEmulator::SetModeFilter(FEXCore::Core::CpuStateFrame* Frame, uin
     return -EACCES;
   }
 
-  if (prog->len > BPF_MAXINSNS || prog->len == 0) {
+  if (UserProg.len > BPF_MAXINSNS || UserProg.len == 0) {
     // operation specified SECCOMP_SET_MODE_FILTER, but the filter program pointed to by args was not valid or the length of the filter
     // program was zero or exceeded BPF_MAXINSNS (4096) instructions.
     return -EINVAL;
   }
 
+  fextl::vector<sock_filter> Instructions(UserProg.len);
+  if (FaultSafeUserMemAccess::CopyFromUser(Instructions.data(), UserProg.filter, UserProg.len * sizeof(sock_filter))) {
+    return -EFAULT;
+  }
+  const sock_fprog LocalProg {
+    .len = UserProg.len,
+    .filter = Instructions.data(),
+  };
+  prog = &LocalProg;
+
   // Don't interrupt me while I'm jitting.
   auto lk = FEXCore::MaskSignalsAndLockMutex(FilterMutex);
 
diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator.cpp
index 98d0752..df50629 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/SignalDelegator.cpp
