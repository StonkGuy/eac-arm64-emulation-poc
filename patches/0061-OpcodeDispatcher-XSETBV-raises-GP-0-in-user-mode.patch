From 626cb94ba4b0cacfec7f55a6aedf3e8586f1141c Mon Sep 17 00:00:00 2001
From: StonkGuy <68372320+StonkGuy@users.noreply.github.com>
Date: Tue, 27 Oct 2026 16:24:26 +0200
Subject: [PATCH] OpcodeDispatcher: XSETBV raises #GP(0) in user mode

XSETBV at CPL 3 raises #GP(0) (the kernel enables XSAVE, so not #UD).
It was marked TYPE_PRIV, an alias of TYPE_INVALID, so the decoder
rejected it and the guest got SIGILL with trapno 0 (Wine: "unexpected
trap 0", an illegal instruction instead of an access violation). Decode
it and raise #GP(0) through PermissionRestrictedOp, as for SWAPGS and
WBINVD.

THE FINALS' anti-cheat executes XSETBV every 20 s and inspects the
exception.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Interface/Core/OpcodeDispatcher/SecondaryModRMTables.h      | 1 +
 .../Source/Interface/Core/X86Tables/SecondaryModRMTables.cpp    | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/SecondaryModRMTables.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher/SecondaryModRMTables.h
index 7386847..037f3e8 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/SecondaryModRMTables.h
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/SecondaryModRMTables.h
@@ -10,6 +10,7 @@ constexpr DispatchTableEntry OpDispatch_SecondaryModRMTables[] = {
 
   // REG /2
   {((1 << 3) | 0), 1, &OpDispatchBuilder::XGetBVOp},
+  {((1 << 3) | 1), 1, &OpDispatchBuilder::PermissionRestrictedOp},
 
   // REG /3
   {((2 << 3) | 7), 1, &OpDispatchBuilder::PermissionRestrictedOp},
diff --git a/FEXCore/Source/Interface/Core/X86Tables/SecondaryModRMTables.cpp b/FEXCore/Source/Interface/Core/X86Tables/SecondaryModRMTables.cpp
index 48417f9..0f20735 100644
--- a/FEXCore/Source/Interface/Core/X86Tables/SecondaryModRMTables.cpp
+++ b/FEXCore/Source/Interface/Core/X86Tables/SecondaryModRMTables.cpp
@@ -27,7 +27,7 @@ constexpr std::array<X86InstInfo, MAX_SECOND_MODRM_TABLE_SIZE> SecondModRMTableO
 
     // REG /2
     {((1 << 3) | 0), 1, X86InstInfo{"XGETBV",   TYPE_INST,    FLAGS_NONE, 0}},
-    {((1 << 3) | 1), 1, X86InstInfo{"XSETBV",   TYPE_PRIV,    FLAGS_NONE, 0}},
+    {((1 << 3) | 1), 1, X86InstInfo{"XSETBV",   TYPE_INST,    FLAGS_NONE, 0}},
     {((1 << 3) | 2), 1, X86InstInfo{"",         TYPE_INVALID, FLAGS_NONE, 0}},
     {((1 << 3) | 3), 1, X86InstInfo{"",         TYPE_INVALID, FLAGS_NONE, 0}},
     {((1 << 3) | 4), 1, X86InstInfo{"",         TYPE_INVALID, FLAGS_NONE, 0}},
