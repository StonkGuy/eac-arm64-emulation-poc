+        "csel x22, x13, x22, eq",
         "cmp x21, #0x0 (0)",
-        "csel x21, x23, x22, eq",
+        "csel x21, x12, x22, eq",
         "strb w21, [x28, #1016]",
         "strh w20, [x28, #964]",
         "ubfx w21, w20, #2, #1",
@@ -80,7 +83,7 @@
         "orr w20, w22, w20, lsr #16",
         "bfi w20, w21, #16, #8",
         "str w20, [x28, #984]",
-        "msr nzcv, x12"
